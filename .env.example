# Environment variables untuk lokal (opsional)
# Jika TURSO_DATABASE_URL diisi, app pakai Turso; kalau kosong, pakai SQLite lokal data/food_rescue.db

# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=eyJ...
# JWT_SECRET=isi-string-acak-panjang

# --- Notifikasi WhatsApp (CallMeBot, gratis) ---
# Dapatkan APIKEY: simpan nomor CallMeBot di kontak HP, kirim "I allow callmebot to send me messages"
# CALLMEBOT_APIKEY=123456

# --- Notifikasi Email (Gmail App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=naylaaurellia910@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM="Food Rescue AI <naylaaurellia910@gmail.com>"
# Semua email notifikasi dikirim ke satu kotak masuk:
# NOTIFY_EMAIL=naylaaurellia910@gmail.com

# --- Gateway WhatsApp lain (opsional, jika tidak pakai CallMeBot) ---
# WHATSAPP_API_URL=https://...
# WHATSAPP_API_TOKEN=...
